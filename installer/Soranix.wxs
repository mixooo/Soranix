<?xml version="1.0" encoding="UTF-8"?>
<!--
  Soranix installer (WiX 3). Built by installer\build-msi.ps1 from release\Soranix.
  Per-user install: no admin prompt, goes to %LOCALAPPDATA%\Programs\Soranix.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi"
     xmlns:util="http://schemas.microsoft.com/wix/UtilExtension">

  <Product Id="*" Name="Soranix" Language="1033" Version="$(var.Version)"
           Manufacturer="Soranix (unofficial)" UpgradeCode="6B1E2C7A-4F7D-4C1B-9E52-3A8D2F0C9B41">

    <Package InstallerVersion="500" Compressed="yes" InstallScope="perUser" InstallPrivileges="limited"
             Platform="x64" Description="Soranix $(var.Version) setup"
             Comments="Unofficial classic-style desktop player for Spotify. Not affiliated with Spotify." />

    <!-- newer (or same-version rebuild) replaces the installed copy -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of Soranix is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- the icon used by Installed apps, the shortcuts and the setup itself -->
    <Icon Id="SoranixIcon.ico" SourceFile="$(var.IconFile)" />
    <Property Id="ARPPRODUCTICON" Value="SoranixIcon.ico" />
    <Property Id="ARPCOMMENTS" Value="Unofficial classic-style desktop player for Spotify. Not affiliated with Spotify." />
    <Property Id="ARPNOREPAIR" Value="1" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="LocalAppDataFolder">
        <Directory Id="ProgramsDir" Name="Programs">
          <Directory Id="INSTALLFOLDER" Name="Soranix" />
          <!-- the old name's folder: only a tiny launcher, see installer\oldname.cs -->
          <Directory Id="OLDNAMEFOLDER" Name="Winampify" />
        </Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder" />
      <Directory Id="DesktopFolder" />
    </Directory>

    <!-- Start menu + Desktop shortcuts, tagged with the app's taskbar id so a pinned shortcut
         and the running app share one taskbar button -->
    <DirectoryRef Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut" Guid="7D3B0C11-2E64-4B7A-A1C9-5F0E8B2D4C61" Win64="yes">
        <Shortcut Id="StartMenuLnk" Name="Soranix" Description="Soranix - classic-style player for Spotify"
                  Target="[INSTALLFOLDER]Soranix.exe" WorkingDirectory="INSTALLFOLDER" Icon="SoranixIcon.ico">
          <ShortcutProperty Key="System.AppUserModel.ID" Value="Soranix" />
        </Shortcut>
        <RegistryValue Root="HKCU" Key="Software\Soranix" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>
    <DirectoryRef Id="DesktopFolder">
      <Component Id="DesktopShortcut" Guid="2F8A5E93-1C7B-4D20-B6E4-9A3C1D7F0E25" Win64="yes">
        <Shortcut Id="DesktopLnk" Name="Soranix" Description="Soranix - classic-style player for Spotify"
                  Target="[INSTALLFOLDER]Soranix.exe" WorkingDirectory="INSTALLFOLDER" Icon="SoranixIcon.ico">
          <ShortcutProperty Key="System.AppUserModel.ID" Value="Soranix" />
        </Shortcut>
        <RegistryValue Root="HKCU" Key="Software\Soranix" Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>
    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="InstallFolderCleanup" Guid="C4E1A7D2-8B3F-4E59-9D16-0F2B7A5C3E84" Win64="yes">
        <RemoveFolder Id="RemoveInstallFolder" On="uninstall" />
        <RemoveFolder Id="RemoveProgramsDir" Directory="ProgramsDir" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\Soranix" Name="InstallFolder" Type="string" Value="[INSTALLFOLDER]" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="OLDNAMEFOLDER">
      <Component Id="OldNameLauncher" Guid="5A9D2E47-3C1B-4F86-8E20-7B4D1C6A9F03" Win64="yes">
        <File Id="OldNameExe" Name="Winampify.exe" Source="$(var.OldNameExe)" />
        <RemoveFolder Id="RemoveOldNameFolder" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\Soranix" Name="OldNameLauncher" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <Feature Id="Main" Title="Soranix" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="OldNameLauncher" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="DesktopShortcut" />
      <ComponentRef Id="InstallFolderCleanup" />
    </Feature>

    <!-- simple setup: notice / license page, progress, then "Launch Soranix" -->
    <UIRef Id="WixUI_Minimal" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseFile)" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch Soranix" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <CustomAction Id="LaunchApplication" BinaryKey="WixCA" DllEntry="WixShellExec" Impersonate="yes" />
    <UI>
      <!-- point the launcher at the installed exe, then run it -->
      <Publish Dialog="ExitDialog" Control="Finish" Event="[WixShellExecTarget]" Value="[INSTALLFOLDER]Soranix.exe" Order="1">
        WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 and NOT Installed
      </Publish>
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchApplication" Order="2">
        WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 and NOT Installed
      </Publish>
    </UI>
  </Product>
</Wix>
